# Public, non-secret settings template for issue #24.
# Copy this to PRIVATE storage and edit the copy. Never commit credentials.
#
# Example:
#   cp config/vllm_video_test.env.example /scratch/<project>/laclaugpt-private/vllm_video_test.env
#   chmod 600 /scratch/<project>/laclaugpt-private/vllm_video_test.env
#   nano /scratch/<project>/laclaugpt-private/vllm_video_test.env
#   set -a; source /scratch/<project>/laclaugpt-private/vllm_video_test.env; set +a

# Public repository checkout.
export LACLAUGPT_MULTIMODAL_PUBLIC_ROOT="$HOME/LaclauGPT-Multimodal-Analysis"

# Private runtime root in project scratch.
export LACLAUGPT_MULTIMODAL_PRIVATE_ROOT="/scratch/<project>/laclaugpt-multimodal"

# Prepared private input CSV from issue #24. The harness should process every
# row in this ~10-video file. Do not point this at the full EP24 dataframe.
export LACLAUGPT_VLLM_TEST_INPUT_CSV="/scratch/<project>/LaclauGPT-Private/analysis/ep24_reprocess/experiments/vllm_video_test_input.csv"

# Project-local environment created with --system-site-packages after loading
# python-vllm.
export LACLAUGPT_VLLM_TEST_VENV="/scratch/<project>/laclaugpt-multimodal/.venv-roihu-vllm"

# Model and inference settings.
export LACLAUGPT_VLLM_TEST_MODEL="Qwen/Qwen3-VL-8B-Instruct"
export LACLAUGPT_VLLM_TEST_MAX_MODEL_LEN="32768"
export LACLAUGPT_VLLM_TEST_MAX_TOKENS="2048"
export LACLAUGPT_VLLM_TEST_TEMPERATURE="0.1"
export LACLAUGPT_VLLM_TEST_TOP_P="0.9"
export LACLAUGPT_VLLM_TEST_GPU_MEMORY_UTILIZATION="0.85"

# Native-video budget.
export LACLAUGPT_VLLM_TEST_VIDEO_MIN_PIXELS="4096"
export LACLAUGPT_VLLM_TEST_VIDEO_MAX_PIXELS="262144"
export LACLAUGPT_VLLM_TEST_VIDEO_TOTAL_PIXELS="20971520"

# Allas. On Roihu, allas-conf defaults to S3 and creates s3allas:.
# Set the bucket containing the EP24 objects. No secrets belong in this file.
export RCLONE_REMOTE="s3allas"
export ALLAS_BUCKET="HEPP24"

# Private outputs. Defaults also exist in the sbatch file.
export LACLAUGPT_VLLM_TEST_DOWNLOAD_DIR="/scratch/<project>/laclaugpt-multimodal/vllm_video_downloads"
export LACLAUGPT_VLLM_TEST_OUTPUT_DIR="/scratch/<project>/laclaugpt-multimodal/csv"
export LACLAUGPT_VLLM_TEST_LOG_DIR="/scratch/<project>/laclaugpt-multimodal/logs"

# The experiment contract fixes this to exactly 1.0 s. Do not change for EP24.
export LACLAUGPT_VLLM_TEST_INITIAL_SKIP_SECONDS="1.0"

# Keep source/trimmed files after the test for debugging: 1=yes, 0=no.
export LACLAUGPT_VLLM_TEST_KEEP_DOWNLOADS="1"

# Optional decoder override if the default vLLM/Qwen backend cannot read an
# EP24 container. Leave empty initially.
# export VLLM_VIDEO_LOADER_BACKEND="torchcodec"
